<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Vynq" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/vynq_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Vynq.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vynq_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Vynq</item>
    </style>
</resources>
